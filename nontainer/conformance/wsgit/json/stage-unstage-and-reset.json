{
  "name": "stage-unstage-and-reset",
  "steps": [
    {
      "command": "ws-git stage",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: stage needs at least one path, or -A. usage: ws-git stage (<paths> | -A); see 'ws-git help'",
      "stdout": ""
    },
    {
      "command": "ws-git stage nope.txt",
      "exit_code": 1,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: unknown path '/workspace/nope.txt': no such file at HEAD or in the working tree",
      "stdout": ""
    },
    {
      "command": "mkdir sub",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git stage sub",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "echo one > a.txt; echo two > b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git stage a.txt b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git unstage a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": " A a.txt\nA  b.txt\n"
    },
    {
      "command": "ws-git reset",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": " A a.txt\n A b.txt\n"
    },
    {
      "command": "ws-git reset --hard",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: reset is mixed-only (no --soft/--hard) — going back to a commit is: ws-git checkout <ref>. usage: ws-git reset; see 'ws-git help'",
      "stdout": ""
    },
    {
      "command": "cat a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "one\n"
    }
  ],
  "summary": "stage needs a path it knows, and a directory with nothing modified under it stages nothing; unstage and reset leave the tree alone."
}
