{
  "name": "stage-then-commit",
  "steps": [
    {
      "command": "echo one > a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "echo two > b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": " A a.txt\n A b.txt\n"
    },
    {
      "command": "ws-git stage a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "A  a.txt\n A b.txt\n"
    },
    {
      "command": "ws-git commit -m 'add a'",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c1>] add a (1 file)\n"
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": " A b.txt\n"
    },
    {
      "command": "ws-git log",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c1> add a\n"
    },
    {
      "command": "ws-git commit -m 'the rest'",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c2>] the rest (1 file)\n"
    },
    {
      "command": "ws-git log --oneline",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c2> the rest\n<c1> add a\n"
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    }
  ],
  "summary": "Staging is silent; status shows the staged and the modified in XY columns; a commit takes the staged set and says so."
}
