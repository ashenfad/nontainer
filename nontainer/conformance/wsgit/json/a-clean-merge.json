{
  "name": "a-clean-merge",
  "steps": [
    {
      "command": "echo base > a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m base",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c1>] base (1 file)\n"
    },
    {
      "command": "ws-git branch worker",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "echo theirs > b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "worker",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m 'worker work'",
      "exit_code": 0,
      "kind": "run",
      "session": "worker",
      "stderr": "",
      "stdout": "[worker <c2>] worker work (1 file)\n"
    },
    {
      "command": "echo mine > c.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m 'my work'",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c3>] my work (1 file)\n"
    },
    {
      "command": "ws-git diff worker",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "# what worker changed since <c4>, where the two last met: what `ws-git merge worker` brings\ndiff --git a/b.txt b/b.txt\n--- a/b.txt\n+++ b/b.txt\n@@ -0,0 +1 @@\n+theirs\n"
    },
    {
      "command": "ws-git diff worker --stat",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "# what worker changed since <c4>, where the two last met: what `ws-git merge worker` brings\n b.txt | 1 +\n 1 file changed, 1 insertion(+), 0 deletions(-)\n"
    },
    {
      "command": "ws-git merge worker",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "Auto-merging b.txt\n[main <c5>] merge worker (1 file)\n"
    },
    {
      "command": "ws-git log",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c5> ws-git.merge from worker\n<c3> my work\n<c1> base\n"
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git merge worker",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c6>] merge worker (0 files)\n"
    },
    {
      "command": "ws-git merge",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: merge takes one session name (ws-git branch lists them), or --abort. usage: ws-git merge (<session> | --abort); see 'ws-git help'",
      "stdout": ""
    },
    {
      "command": "ws-git merge nobody",
      "exit_code": 1,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: unknown branch 'nobody'",
      "stdout": ""
    }
  ],
  "summary": "diff <session> shows what a merge would bring; the merge names what it took and lands; the log shows where it came from."
}
