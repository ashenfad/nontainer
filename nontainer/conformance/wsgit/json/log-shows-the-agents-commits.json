{
  "name": "log-shows-the-agents-commits",
  "steps": [
    {
      "command": "ws-git log",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "# no ws-git commits in this session: `ws-git log --all` lists every commit it holds, turn commits included\n"
    },
    {
      "command": "echo one > a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git log",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "# no ws-git commits in this session: `ws-git log --all` lists every commit it holds, turn commits included\n"
    },
    {
      "command": "ws-git commit -m first",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c1>] first (1 file)\n"
    },
    {
      "command": "echo two > a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m second",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c2>] second (1 file)\n"
    },
    {
      "command": "ws-git log",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c2> second\n<c1> first\n"
    },
    {
      "command": "ws-git log -n 1",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c2> second\n"
    },
    {
      "command": "ws-git log -1",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c2> second\n"
    },
    {
      "command": "ws-git log -n 0",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git log --all",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c3> ws-git.restore\n<c2> second\n<c4> terminal\n<c5> ws-git.restore\n<c1> first\n<c6> terminal\n<c7> init\n<c8> ?\n"
    },
    {
      "command": "ws-git log --graph",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: log takes no '--graph' (try: -n N, -N, --oneline, --all, -S <string>). usage: ws-git log [<session>] [-n N] [--all] [-S <string>]; see 'ws-git help'",
      "stdout": ""
    }
  ],
  "summary": "log lists only the agent's commits; --all every commit; -n and -N limit; an empty log says where the history is."
}
