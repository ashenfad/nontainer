{
  "name": "log-pickaxe",
  "steps": [
    {
      "command": "echo 'needle here' > a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m 'add needle'",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c1>] add needle (1 file)\n"
    },
    {
      "command": "echo 'nothing' > a.txt; echo 'needle here' > b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m 'move needle'",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c2>] move needle (2 files)\n"
    },
    {
      "command": "echo 'gone' > b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m 'drop needle'",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c3>] drop needle (1 file)\n"
    },
    {
      "command": "ws-git log -S needle",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c3> - drop needle\n<c1> + add needle\n"
    },
    {
      "command": "ws-git log -S nowhere",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git log -S",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: log takes no '-S' (try: -n N, -N, --oneline, --all, -S <string>). usage: ws-git log [<session>] [-n N] [--all] [-S <string>]; see 'ws-git help'",
      "stdout": ""
    }
  ],
  "summary": "-S finds the commits where a string appeared (+) or vanished (-), not where it only moved."
}
