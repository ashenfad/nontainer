{
  "name": "diff-unstaged-cached-and-stat",
  "steps": [
    {
      "command": "cat > a.txt <<'EOF'\none\ntwo\nthree\nEOF",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "echo keep > b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m base",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c1>] base (2 files)\n"
    },
    {
      "command": "cat > a.txt <<'EOF'\none\nTWO\nthree\nfour\nEOF",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "echo new > c.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git diff",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "diff --git a/a.txt b/a.txt\n--- a/a.txt\n+++ b/a.txt\n@@ -1,3 +1,4 @@\n one\n-two\n+TWO\n three\n+four\ndiff --git a/c.txt b/c.txt\n--- a/c.txt\n+++ b/c.txt\n@@ -0,0 +1 @@\n+new\n"
    },
    {
      "command": "ws-git diff --stat",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": " a.txt | 3 ++-\n c.txt | 1 +\n 2 files changed, 3 insertions(+), 1 deletion(-)\n"
    },
    {
      "command": "ws-git stage a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git diff --cached",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "diff --git a/a.txt b/a.txt\n--- a/a.txt\n+++ b/a.txt\n@@ -1,3 +1,4 @@\n one\n-two\n+TWO\n three\n+four\n"
    },
    {
      "command": "ws-git diff",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "diff --git a/c.txt b/c.txt\n--- a/c.txt\n+++ b/c.txt\n@@ -0,0 +1 @@\n+new\n"
    },
    {
      "command": "ws-git diff -- a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git diff nope.txt",
      "exit_code": 1,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: ambiguous argument 'nope.txt': unknown session, store tag or path. ws-git branch lists the sessions; a pathspec has to name something in your tree.",
      "stdout": ""
    },
    {
      "command": "ws-git diff --word-diff",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: diff takes no '--word-diff'. usage: ws-git diff [<session>] [--cached] [--check] [--stat] [[--] <paths>]; see 'ws-git help'",
      "stdout": ""
    }
  ],
  "summary": "A unified diff against the last commit; --cached the staged set; --stat a summary."
}
