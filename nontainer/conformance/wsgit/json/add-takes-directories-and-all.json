{
  "name": "add-takes-directories-and-all",
  "steps": [
    {
      "command": "mkdir -p src docs && echo a > src/a.py && echo b > src/b.py && echo d > docs/d.md",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git add src",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": " A docs/d.md\nA  src/a.py\nA  src/b.py\n"
    },
    {
      "command": "ws-git reset",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git add -A",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "A  docs/d.md\nA  src/a.py\nA  src/b.py\n"
    },
    {
      "command": "ws-git commit -m all",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c1>] all (3 files)\n"
    },
    {
      "command": "ws-git add",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: add needs at least one path, or -A. usage: ws-git add (<paths> | -A); see 'ws-git help'",
      "stdout": ""
    },
    {
      "command": "ws-git add --patch",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: add takes no '--patch'. usage: ws-git add (<paths> | -A); see 'ws-git help'",
      "stdout": ""
    },
    {
      "command": "echo a2 > src/a.py && echo d2 > docs/d.md",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git add -A src/a.py",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": " M docs/d.md\nM  src/a.py\n"
    },
    {
      "command": "ws-git reset",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "rm -r docs",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git add docs",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "D  docs/d.md\n M src/a.py\n"
    }
  ],
  "summary": "add stages what is modified under a directory, -A everything, and refuses what it doesn't mean; a removed directory stages its removal."
}
