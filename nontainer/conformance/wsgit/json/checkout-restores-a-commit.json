{
  "name": "checkout-restores-a-commit",
  "steps": [
    {
      "command": "echo one > a.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m first",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c1>] first (1 file)\n"
    },
    {
      "command": "echo two > a.txt; echo b > b.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git commit -m second",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main <c2>] second (2 files)\n"
    },
    {
      "command": "ws-git log",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c2> second\n<c1> first\n"
    },
    {
      "command": "ws-git checkout <c1>",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "[main] restored to <c1>\n"
    },
    {
      "command": "cat a.txt; ls",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "one\na.txt\n"
    },
    {
      "command": "ws-git status",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git log",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c1> first\n"
    },
    {
      "command": "echo framework > f.txt",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": ""
    },
    {
      "command": "ws-git log --all -n 1",
      "exit_code": 0,
      "kind": "run",
      "session": "main",
      "stderr": "",
      "stdout": "<c3> terminal\n"
    },
    {
      "command": "ws-git checkout <c3>",
      "exit_code": 1,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: <c3> is a commit of this session but not one of yours (ws-git log lists yours) — moving the whole session to any commit in its history is the host's to invoke: ws.checkout(<id>).",
      "stdout": ""
    },
    {
      "command": "ws-git checkout worker",
      "exit_code": 1,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: 'worker' is not a commit — sessions are branches, and a branch does not switch here. Name a commit from ws-git log, or a tag from ws-git tag.",
      "stdout": ""
    },
    {
      "command": "ws-git checkout",
      "exit_code": 2,
      "kind": "run",
      "session": "main",
      "stderr": "ws-git: checkout takes one ref (a commit from ws-git log). usage: ws-git checkout <ref> [-- <paths>]; see 'ws-git help'",
      "stdout": ""
    }
  ],
  "summary": "checkout puts the tree back as a new commit; a framework commit and a session name are refused."
}
